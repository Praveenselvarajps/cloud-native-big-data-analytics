*$py.class
.pytest_cache/
.coverage
htmlcov/

# Local IDE files
.vscode/
.idea/

# Local data files (data is ingested from S3 in cloud production)
data/raw/
data/processed/
data/rejected/
*.log

# Documentation and presentations
docs/
*.md
