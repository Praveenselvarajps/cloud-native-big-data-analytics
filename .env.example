# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your values for local live AWS testing.
# NEVER commit the real .env file to Git!
# ==============================================================================

# Application Environment Mode:
# Set to 'development' to run locally with sample data / mocked services
# Set to 'production' when connecting to live AWS S3 & Athena
APP_ENV=development

# AWS Region (e.g., us-east-1, us-west-2, ap-south-1)
AWS_REGION=us-east-1

# AWS Credentials (used locally for testing; leave blank if using AWS CLI profiles or IAM Roles)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Amazon S3 Bucket & Folder Prefixes
S3_BUCKET_NAME=my-ecommerce-analytics-bucket-unique-id
S3_RAW_PREFIX=data/raw/
S3_PROCESSED_PREFIX=data/processed/
S3_REJECTED_PREFIX=data/rejected/

# Amazon Athena Query Configuration
ATHENA_DATABASE=ecommerce_analytics_db
ATHENA_TABLE=processed_orders
ATHENA_OUTPUT_LOCATION=s3://my-ecommerce-analytics-bucket-unique-id/athena-results/
